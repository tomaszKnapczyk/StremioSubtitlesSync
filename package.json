{
  "name": "stremio-subtitle-sync",
  "version": "1.0.0",
  "description": "Stremio addon: OpenSubtitles subtitles aligned to a hash-matched reference subtitle.",
  "main": "dist/src/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:torbox": "tsx --env-file-if-exists=.env scripts/torbox-check.ts",
    "check:tracks": "tsx --env-file-if-exists=.env scripts/probe-tracks.ts",
    "check:extract": "tsx --env-file-if-exists=.env scripts/extract-check.ts",
    "check:napi": "tsx --env-file-if-exists=.env scripts/napi-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.5.1",
    "@types/stremio-addon-sdk": "^1.6.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
